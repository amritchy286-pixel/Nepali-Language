काम खालीसूची(
    सूची मान
) -> सत्य {
    फर्काऊ लम्बाइ(मान) == 0
}

काम सूचीछैनखाली(
    सूची मान
) -> सत्य {
    फर्काऊ लम्बाइ(मान) > 0
}

काम सूचीमाछ(
    सूची मान,
    पाठ खोज
) -> सत्य {
    फर्काऊ छकि(मान, खोज)
}

काम सूचीथप(
    सूची मान,
    पाठ नयाँमान
) {
    थप(मान, नयाँमान)
}

काम सूचीहटाऊ(
    सूची मान,
    पाठ हटाउनेमान
) {
    हटाऊ(मान, हटाउनेमान)
}

काम सूचीलम्बाइ(
    सूची मान
) -> पूर्णाङ्क {
    फर्काऊ लम्बाइ(मान)
}