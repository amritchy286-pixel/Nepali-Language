काम खालीछ(
    पाठ मान
) -> सत्य {
    फर्काऊ लम्बाइ(मान) == 0
}

काम खालीछैन(
    पाठ मान
) -> सत्य {
    फर्काऊ लम्बाइ(मान) > 0
}

काम बराबर(
    पाठ पहिलो,
    पाठ दोस्रो
) -> सत्य {
    फर्काऊ पहिलो == दोस्रो
}

काम फरक(
    पाठ पहिलो,
    पाठ दोस्रो
) -> सत्य {
    फर्काऊ पहिलो != दोस्रो
}

काम लामोछ(
    पाठ मान,
    पूर्णाङ्क सीमा
) -> सत्य {
    फर्काऊ लम्बाइ(मान) > सीमा
}

काम छोटोछ(
    पाठ मान,
    पूर्णाङ्क सीमा
) -> सत्य {
    फर्काऊ लम्बाइ(मान) < सीमा
}