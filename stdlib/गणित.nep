काम जोड(
    पूर्णाङ्क क,
    पूर्णाङ्क ख
) -> पूर्णाङ्क {
    फर्काऊ क + ख
}

काम घटाऊ(
    पूर्णाङ्क क,
    पूर्णाङ्क ख
) -> पूर्णाङ्क {
    फर्काऊ क - ख
}

काम गुणा(
    पूर्णाङ्क क,
    पूर्णाङ्क ख
) -> पूर्णाङ्क {
    फर्काऊ क * ख
}

काम भाग(
    पूर्णाङ्क क,
    पूर्णाङ्क ख
) -> दशमलव {
    फर्काऊ क / ख
}

काम वर्ग(
    पूर्णाङ्क संख्या
) -> पूर्णाङ्क {
    फर्काऊ संख्या * संख्या
}

काम घन(
    पूर्णाङ्क संख्या
) -> पूर्णाङ्क {
    फर्काऊ संख्या * संख्या * संख्या
}

काम घात(
    पूर्णाङ्क आधार,
    पूर्णाङ्क शक्ति
) -> पूर्णाङ्क {
    फर्काऊ आधार ^ शक्ति
}