काम धनात्मक(
    पूर्णाङ्क संख्या
) -> सत्य {
    फर्काऊ संख्या > 0
}

काम ऋणात्मक(
    पूर्णाङ्क संख्या
) -> सत्य {
    फर्काऊ संख्या < 0
}

काम शून्यहो(
    पूर्णाङ्क संख्या
) -> सत्य {
    फर्काऊ संख्या == 0
}

काम ठूलो(
    पूर्णाङ्क पहिलो,
    पूर्णाङ्क दोस्रो
) -> पूर्णाङ्क {
    यदि (पहिलो > दोस्रो) {
        फर्काऊ पहिलो
    }

    फर्काऊ दोस्रो
}

काम सानो(
    पूर्णाङ्क पहिलो,
    पूर्णाङ्क दोस्रो
) -> पूर्णाङ्क {
    यदि (पहिलो < दोस्रो) {
        फर्काऊ पहिलो
    }

    फर्काऊ दोस्रो
}

काम निरपेक्ष(
    पूर्णाङ्क संख्या
) -> पूर्णाङ्क {
    यदि (संख्या < 0) {
        फर्काऊ -संख्या
    }

    फर्काऊ संख्या
}

काम जोर(
    पूर्णाङ्क संख्या
) -> सत्य {
    फर्काऊ संख्या % 2 == 0
}

काम बिजोर(
    पूर्णाङ्क संख्या
) -> सत्य {
    फर्काऊ संख्या % 2 != 0
}